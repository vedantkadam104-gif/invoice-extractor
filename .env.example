# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Model to use for extraction
OPENROUTER_MODEL=google/gemini-2.5-flash

# ─── API Settings ─────────────────────────────────────────────────────────────
# How many seconds to wait for the LLM response
LLM_TIMEOUT=60

# ─── Streamlit ────────────────────────────────────────────────────────────────
# Internal URL the UI uses to reach the API (use localhost for local run, api for Docker)
API_BASE_URL=http://localhost:8000
